{
  "name": "stream-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "feed": "tsx scripts/feeder.ts",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"scripts/**/*.{ts,mjs,json}\" \"tests/**/*.ts\" \"public/overlay/**/*.{html,css,js}\"",
    "nllb": "python3 scripts/nllb_server.py"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
